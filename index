<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code Viewer & Editor</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 500: '#6366f1', 600: '#4f46e5' }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter & Fira Code -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap"
        rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .code-font {
            font-family: 'Fira Code', monospace;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.1);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.4);
            border-radius: 4px;
        }
    </style>
</head>

<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">

    <header
        class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg z-10">
        <div class="flex items-center space-x-3">
            <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md flex items-center justify-center w-10 h-10">
                <i class="fa-solid fa-code text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-base tracking-tight flex items-center gap-2">
                    Code Viewer & Editor <span
                        class="text-[10px] px-2 py-0.5 bg-indigo-500/20 text-indigo-400 rounded-full font-medium border border-indigo-500/35">ESP32
                        Dashboard Ready</span>
                </h1>
                <p class="text-[11px] text-slate-400">Your RC Cyber Dashboard code is loaded successfully</p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="toggleHelp()"
                class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-xs font-medium rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                <i class="fa-solid fa-circle-question text-indigo-400"></i>
                <span>Help / උපදෙස්</span>
            </button>
            <button onclick="copyCode()"
                class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-xs font-semibold text-white rounded-lg shadow-md flex items-center gap-1.5 transition">
                <i class="fa-solid fa-copy"></i>
                <span>Copy Code</span>
            </button>
        </div>
    </header>

    <div id="help-banner"
        class="hidden bg-slate-900/90 border-b border-slate-800 px-6 py-4 text-xs space-y-2 backdrop-blur">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between gap-4">
            <div class="space-y-1">
                <p class="font-bold text-indigo-400"><i class="fa-solid fa-info-circle mr-1"></i> Instructions / භාවිත
                    කරන ආකාරය:</p>
                <p class="text-slate-300">1. Your custom RC Dashboard HTML code is already pre-loaded into the editor.
                </p>
                <p class="text-slate-300">2. Use the 'Copy Code' button at the top right to copy the entire code
                    instantly.</p>
            </div>
            <button onclick="toggleHelp()" class="self-start text-slate-400 hover:text-white px-2 py-1 text-sm"><i
                    class="fa-solid fa-xmark"></i></button>
        </div>
    </div>

    <main class="flex-1 flex flex-col p-4 sm:p-6 max-w-7xl w-full mx-auto">
        <div
            class="flex-1 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl flex flex-col overflow-hidden relative">

            <div
                class="bg-slate-800/60 border-b border-slate-800 px-4 py-2.5 flex items-center justify-between text-xs text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                    <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                    <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                    <span class="ml-2 font-mono text-[11px] text-slate-300">rc_dashboard.html</span>
                </div>
                <div id="status-indicator" class="text-emerald-400 font-medium flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Loaded
                </div>
            </div>

            <!-- Editor Grid: Line Numbers + Textarea -->
            <div class="flex-1 flex relative overflow-hidden bg-slate-950">
                <!-- Line Numbers Sidebar -->
                <div id="line-numbers"
                    class="w-14 bg-slate-900/80 border-r border-slate-800 text-slate-500 code-font text-xs py-4 px-2 select-none text-right overflow-hidden leading-relaxed">
                    1
                </div>
                

                 <!----
                <textarea id="code-textarea" readonly onscroll="syncScroll()"
                    class="flex-1 bg-transparent text-slate-100 code-font text-xs sm:text-sm p-4 resize-none focus:outline-none leading-relaxed whitespace-pre overflow-auto cursor-default select-text"
                    spellcheck="false">
    

                    මෙතැනට ඔබේ ESP32 කේතය අලවන්න (Paste කරන්න)
                       


                </textarea> -->  
                <textarea id="code-textarea" readonly onscroll="syncScroll()"
                    class="flex-1 bg-transparent text-slate-100 code-font text-xs sm:text-sm p-4 resize-none focus:outline-none leading-relaxed whitespace-pre overflow-auto cursor-default select-text"
                    spellcheck="false">
    





                </textarea>
                <!----
                <textarea id="code-textarea" readonly onscroll="syncScroll()"
                    class="flex-1 bg-transparent text-slate-100 code-font text-xs sm:text-sm p-4 resize-none focus:outline-none leading-relaxed whitespace-pre overflow-auto cursor-default select-text"
                    spellcheck="false">
    

                    මෙතැනට ඔබේ ESP32 කේතය අලවන්න (Paste කරන්න)
                       


                </textarea> -->                
               


            </div>

            <!-- Footer Stats bar -->
            <div
                class="bg-slate-900 border-t border-slate-800 px-4 py-2 text-[11px] text-slate-400 flex flex-col sm:flex-row justify-between items-center gap-2">
                <div class="flex items-center gap-4">
                    <span id="line-count-stat">Lines: 1</span>
                    <span id="char-count-stat">Characters: 0</span>
                </div>
                <div class="text-slate-500">
                    RC Cyber Dashboard Code Viewer
                </div>
            </div>
        </div>
    </main>

    <div id="toast"
        class="fixed bottom-6 right-6 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-800 border border-slate-700 text-white px-4 py-2.5 rounded-xl shadow-2xl text-xs font-medium z-50 flex items-center gap-2">
        <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toast-message">Action successful</span>
    </div>

    <script>
        function toggleHelp() {
            const banner = document.getElementById('help-banner');
            banner.classList.toggle('hidden');
        }

        function updateLineNumbers() {
            const textarea = document.getElementById('code-textarea');
            const lineNumbersDiv = document.getElementById('line-numbers');
            const lines = textarea.value.split('\n');
            const lineCount = lines.length || 1;

            let numbersHtml = '';
            for (let i = 1; i <= lineCount; i++) {
                numbersHtml += i + '<br>';
            }
            lineNumbersDiv.innerHTML = numbersHtml;
        }

        function updateStats() {
            const textarea = document.getElementById('code-textarea');
            const text = textarea.value;
            const lines = text.split('\n').length;
            const chars = text.length;

            document.getElementById('line-count-stat').innerText = `Lines: ${lines}`;
            document.getElementById('char-count-stat').innerText = `Characters: ${chars}`;
        }

        function syncScroll() {
            const textarea = document.getElementById('code-textarea');
            const lineNumbersDiv = document.getElementById('line-numbers');
            lineNumbersDiv.scrollTop = textarea.scrollTop;
        }

        function copyCode() {
            const textarea = document.getElementById('code-textarea');
            const code = textarea.value;

            if (!code.trim()) {
                showToast('Nothing to copy', 'fa-triangle-exclamation', 'text-amber-400');
                return;
            }

            const tempArea = document.createElement("textarea");
            tempArea.value = code;
            document.body.appendChild(tempArea);
            tempArea.select();
            try {
                document.execCommand('copy');
                showToast('Code copied to clipboard successfully!', 'fa-circle-check', 'text-emerald-400');
            } catch (err) {
                showToast('Failed to copy code', 'fa-triangle-exclamation', 'text-rose-400');
            }
            document.body.removeChild(tempArea);
        }

        function showToast(message, iconClass, iconColorClass) {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            msgEl.innerText = message;
            iconEl.className = `fa-solid ${iconClass} ${iconColorClass}`;

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Initialize line numbers and stats on load
        window.onload = function () {
            updateLineNumbers();
            updateStats();
        };
    </script>
</body>

</html>
